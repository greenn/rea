# REA binds to loopback only by default.
REA_HOST=127.0.0.1
REA_PORT=18787

# Durable local library. Leave empty to use %LOCALAPPDATA%\REA\data on Windows
# or ~/.local/share/rea on Linux/macOS.
REA_DATA_DIR=

# Whisper defaults.
REA_WHISPER_MODEL=large-v3
REA_WHISPER_DEVICE=cpu
REA_WHISPER_COMPUTE_TYPE=int8

# Optional: use an explicit faster-whisper model cache directory.
# Leave empty to use the normal Hugging Face cache. If the old CC Whisper
# service used the normal cache, REA will reuse the already downloaded model.
REA_WHISPER_MODEL_DIR=

# Local AIB text correction service.
REA_AIB_URL=http://127.0.0.1:8282
REA_AIB_MODEL=qwen3:4b
REA_AIB_TIMEOUT_SECONDS=180

# Maximum direct audio upload size accepted by REA's Whisper API.
REA_MAX_UPLOAD_MB=2048
